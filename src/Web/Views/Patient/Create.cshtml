@model CreatePatientViewModel
@using FonoChampionHub.Domain.Enums
@{
    ViewData["Title"] = "Cadastrar paciente";
}

<h1 class="h2 mb-4">Cadastrar paciente</h1>

<form asp-action="Create" method="post" class="form-layout">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Nome completo</label>
        <input asp-for="FullName" class="form-control" autocomplete="name" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label">Data de nascimento</label>
        <input asp-for="DateOfBirth" class="form-control" type="date" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label for="cid-search" class="form-label">Buscar CID-10 por código ou descrição</label>
        <input id="cid-search"
               class="form-control"
               type="search"
               autocomplete="off"
               data-search-url="@Url.Action("SearchCid", "Patient")"
               aria-describedby="cid-search-status" />
        <div id="cid-search-status" class="form-text" role="status" aria-live="polite">
            Digite pelo menos 2 caracteres para buscar.
        </div>
        <div id="cid-search-results" class="list-group mt-2" aria-label="Resultados CID-10"></div>
        <input asp-for="Cid10Code" type="hidden" />
        <input asp-for="Cid10Description" type="hidden" />
        <p id="cid-selected" class="mt-2 mb-0" aria-live="polite">
            @if (!string.IsNullOrEmpty(Model.Cid10Code))
            {
                <span>CID selecionado: @Model.Cid10Code — @Model.Cid10Description</span>
            }
        </p>
        <span asp-validation-for="Cid10Code" class="text-danger"></span>
    </div>
    <fieldset class="mb-4">
        <legend class="h5">Profissionais associados (opcional)</legend>
        @if (Model.AvailableProfessionals.Count == 0)
        {
            <p class="form-text">Não há profissionais cadastrados disponíveis.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var professional in Model.AvailableProfessionals)
                {
                    <label class="list-group-item">
                        <input class="form-check-input me-2"
                               type="checkbox"
                               name="ProfessionalIds"
                               value="@professional.Id"
                               checked="@Model.ProfessionalIds.Contains(professional.Id)" />
                        @professional.FullName
                    </label>
                }
            </div>
        }
        <span asp-validation-for="ProfessionalIds" class="text-danger"></span>
    </fieldset>
    <fieldset class="mb-4">
        <legend class="h5">Responsáveis (opcional)</legend>
        <div id="responsible-person-list">
            @for (var index = 0; index < Model.ResponsiblePersons.Count; index++)
            {
                <div class="row g-3 align-items-end mb-3" data-responsible-person-row>
                    <div class="col-md-5">
                        <label asp-for="ResponsiblePersons[index].FullName"
                               data-responsible-person-label="FullName"
                               class="form-label">Nome completo</label>
                        <input asp-for="ResponsiblePersons[index].FullName"
                               data-responsible-person-input="FullName"
                               class="form-control"
                               autocomplete="name" />
                        <span asp-validation-for="ResponsiblePersons[index].FullName"
                              data-responsible-person-validation="FullName"
                              class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="ResponsiblePersons[index].Kinship"
                               data-responsible-person-label="Kinship"
                               class="form-label">Parentesco</label>
                        <select asp-for="ResponsiblePersons[index].Kinship"
                                data-responsible-person-input="Kinship"
                                asp-items="Html.GetEnumSelectList<ResponsiblePersonKinship>()"
                                class="form-select">
                            <option value="">Selecione</option>
                        </select>
                        <span asp-validation-for="ResponsiblePersons[index].Kinship"
                              data-responsible-person-validation="Kinship"
                              class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-secondary" data-remove-responsible-person>
                            Remover
                        </button>
                    </div>
                    <div class="col-12">
                        <fieldset class="border rounded p-3">
                            <legend class="h6">Contatos (ao menos um)</legend>
                            <div data-responsible-person-contact-list>
                                @for (var contactIndex = 0;
                                     contactIndex < Model.ResponsiblePersons[index].Contacts.Count;
                                     contactIndex++)
                                {
                                    <div class="row g-3 align-items-end mb-3"
                                         data-responsible-person-contact-row>
                                        <div class="col-md-3">
                                            <label asp-for="ResponsiblePersons[index].Contacts[contactIndex].Type"
                                                   data-contact-label="Type"
                                                   class="form-label">Tipo</label>
                                            <select asp-for="ResponsiblePersons[index].Contacts[contactIndex].Type"
                                                    data-contact-input="Type"
                                                    asp-items="Html.GetEnumSelectList<ContactMethodType>()"
                                                    class="form-select">
                                                <option value="">Selecione</option>
                                            </select>
                                            <span asp-validation-for="ResponsiblePersons[index].Contacts[contactIndex].Type"
                                                  data-contact-validation="Type"
                                                  class="text-danger"></span>
                                        </div>
                                        <div class="col-md-7">
                                            <label asp-for="ResponsiblePersons[index].Contacts[contactIndex].Value"
                                                   data-contact-label="Value"
                                                   class="form-label">Valor</label>
                                            <input asp-for="ResponsiblePersons[index].Contacts[contactIndex].Value"
                                                   data-contact-input="Value"
                                                   class="form-control"
                                                   autocomplete="off" />
                                            <span asp-validation-for="ResponsiblePersons[index].Contacts[contactIndex].Value"
                                                  data-contact-validation="Value"
                                                  class="text-danger"></span>
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    data-remove-responsible-person-contact>
                                                Remover contato
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-add-responsible-person-contact>
                                Adicionar telefone ou e-mail
                            </button>
                        </fieldset>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="btn btn-outline-primary" id="add-responsible-person">
            Adicionar responsável
        </button>
    </fieldset>
    <button type="submit" class="btn btn-primary">Cadastrar paciente</button>
</form>

<template id="responsible-person-template">
    <div class="row g-3 align-items-end mb-3" data-responsible-person-row>
        <div class="col-md-5">
            <label for="ResponsiblePersons___index___FullName"
                   data-responsible-person-label="FullName"
                   class="form-label">Nome completo</label>
            <input id="ResponsiblePersons___index___FullName"
                   name="ResponsiblePersons[__index__].FullName"
                   data-responsible-person-input="FullName"
                   class="form-control"
                   autocomplete="name" />
            <span class="text-danger"
                  data-valmsg-for="ResponsiblePersons[__index__].FullName"
                  data-responsible-person-validation="FullName"></span>
        </div>
        <div class="col-md-5">
            <label for="ResponsiblePersons___index___Kinship"
                   data-responsible-person-label="Kinship"
                   class="form-label">Parentesco</label>
            <select id="ResponsiblePersons___index___Kinship"
                    name="ResponsiblePersons[__index__].Kinship"
                    data-responsible-person-input="Kinship"
                    class="form-select">
                <option value="">Selecione</option>
                @foreach (var option in Html.GetEnumSelectList<ResponsiblePersonKinship>())
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <span class="text-danger"
                  data-valmsg-for="ResponsiblePersons[__index__].Kinship"
                  data-responsible-person-validation="Kinship"></span>
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-outline-secondary" data-remove-responsible-person>
                Remover
            </button>
        </div>
        <div class="col-12">
            <fieldset class="border rounded p-3">
                <legend class="h6">Contatos (ao menos um)</legend>
                <div data-responsible-person-contact-list>
                    <div class="row g-3 align-items-end mb-3"
                         data-responsible-person-contact-row>
                        <div class="col-md-3">
                            <label data-contact-label="Type" class="form-label">Tipo</label>
                            <select data-contact-input="Type" class="form-select">
                                <option value="">Selecione</option>
                                @foreach (var option in Html.GetEnumSelectList<ContactMethodType>())
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                            <span class="text-danger" data-contact-validation="Type"></span>
                        </div>
                        <div class="col-md-7">
                            <label data-contact-label="Value" class="form-label">Valor</label>
                            <input data-contact-input="Value" class="form-control" autocomplete="off" />
                            <span class="text-danger" data-contact-validation="Value"></span>
                        </div>
                        <div class="col-md-2">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-remove-responsible-person-contact>
                                Remover contato
                            </button>
                        </div>
                    </div>
                </div>
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        data-add-responsible-person-contact>
                    Adicionar telefone ou e-mail
                </button>
            </fieldset>
        </div>
    </div>
</template>

<template id="responsible-person-contact-template">
    <div class="row g-3 align-items-end mb-3" data-responsible-person-contact-row>
        <div class="col-md-3">
            <label data-contact-label="Type" class="form-label">Tipo</label>
            <select data-contact-input="Type" class="form-select">
                <option value="">Selecione</option>
                @foreach (var option in Html.GetEnumSelectList<ContactMethodType>())
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <span class="text-danger" data-contact-validation="Type"></span>
        </div>
        <div class="col-md-7">
            <label data-contact-label="Value" class="form-label">Valor</label>
            <input data-contact-input="Value" class="form-control" autocomplete="off" />
            <span class="text-danger" data-contact-validation="Value"></span>
        </div>
        <div class="col-md-2">
            <button type="button"
                    class="btn btn-outline-secondary"
                    data-remove-responsible-person-contact>
                Remover contato
            </button>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/patient-cid-search.js" asp-append-version="true"></script>
    <script src="~/js/patient-responsible-persons.js" asp-append-version="true"></script>
}
