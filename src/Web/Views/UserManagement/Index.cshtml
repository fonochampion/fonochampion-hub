@model AccountListViewModel
@{
    ViewData["Title"] = "Contas de usuários";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h2 mb-0">Contas de usuários</h1>
    <a class="btn btn-primary" asp-action="Create">Criar conta</a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Nome de exibição</th>
                <th scope="col">Usuário</th>
                <th scope="col">Email</th>
                <th scope="col">Papel</th>
                <th scope="col">Estado</th>
                <th scope="col"><span class="visually-hidden">Ações</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in Model.Accounts)
            {
                <tr>
                    <td>@account.DisplayName</td>
                    <td>@account.Username</td>
                    <td>@(account.Email ?? "—")</td>
                    <td>@(string.IsNullOrEmpty(account.Role) ? "—" : account.Role)</td>
                    <td>@(account.IsActive ? "Ativa" : "Inativa")</td>
                    <td>
                        <a class="btn btn-outline-primary btn-sm"
                           asp-action="Edit"
                           asp-route-id="@account.Id">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
