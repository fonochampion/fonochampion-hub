@model CreateCancellationReasonViewModel
@{
    ViewData["Title"] = "Criar motivo de cancelamento";
}

<h1 class="h2 mb-4">Criar motivo de cancelamento</h1>
<form asp-action="Create" method="post" class="form-layout">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nome</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Description" class="form-label">Descrição (opcional)</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Criar motivo</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
