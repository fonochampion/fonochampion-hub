@model EditProfessionalViewModel
@{
    ViewData["Title"] = "Editar profissional";
}

<h1 class="h2 mb-4">Editar profissional</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-layout">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <partial name="_ProfessionalFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Salvar alterações</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/professional-registration.js" asp-append-version="true"></script>
}
