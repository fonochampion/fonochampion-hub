@model CreateProfessionalViewModel
@{
    ViewData["Title"] = "Cadastrar profissional";
}

<h1 class="h2 mb-4">Cadastrar profissional</h1>

<form asp-action="Create" method="post" class="form-layout">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <partial name="_ProfessionalFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Cadastrar profissional</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/professional-registration.js" asp-append-version="true"></script>
}
